ninja_required_version = 1.3
cxx = c++

cflags = -pthread -B /home/hal/Shijia/anaconda3/envs/tridet/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/hal/Shijia/anaconda3/envs/tridet/include -I/home/hal/Shijia/anaconda3/envs/tridet/include -fPIC -O2 -isystem /home/hal/Shijia/anaconda3/envs/tridet/include -fPIC -I/home/hal/Shijia/anaconda3/envs/tridet/lib/python3.9/site-packages/torch/include -I/home/hal/Shijia/anaconda3/envs/tridet/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/hal/Shijia/anaconda3/envs/tridet/lib/python3.9/site-packages/torch/include/TH -I/home/hal/Shijia/anaconda3/envs/tridet/lib/python3.9/site-packages/torch/include/THC -I/home/hal/Shijia/anaconda3/envs/tridet/include/python3.9 -c
post_cflags = -fopenmp -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=nms_1d_cpu -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc



